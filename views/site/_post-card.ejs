<article class="post-card">
  <a class="post-card__img" href="<%= L('/novosti/' + p.slug) %>" tabindex="-1" aria-hidden="true">
    <% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><span class="post-card__ph"><%- icon('doc') %></span><% } %>
  </a>
  <div class="post-card__body">
    <div class="post-card__meta"><span class="tag"><%= s.news_cats[p.category] || '' %></span><time datetime="<%= p.published_at %>"><%= fmtDate(p.published_at, lang) %></time></div>
    <h3 class="post-card__title"><a href="<%= L('/novosti/' + p.slug) %>"><%= f(p, 'title') %></a></h3>
    <% if (f(p, 'excerpt')) { %><p class="post-card__text"><%= f(p, 'excerpt') %></p><% } %>
  </div>
</article>
