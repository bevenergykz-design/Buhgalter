<%
  const ARTS = { services: 'uslugi.webp', news: 'novosti.webp', about: 'o-kompanii.webp', contacts: 'kontakty.webp', pay: 'oplata.webp', video: 'video.webp' };
  const art = locals.art === false ? '' : (locals.art || ARTS[locals.page] || 'dokument.webp');
  const art3d = /\.webp$/.test(art);
%>
<section class="page-head<%= art ? ' page-head--has-art' : '' %><%= locals.center ? ' page-head--center' : '' %>">
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumbs">
      <a href="<%= L('/') %>"><%= s.breadcrumbs_home %></a>
      <% (locals.crumbs || []).forEach(function(c){ %><span>/</span><a href="<%= c[0] %>"><%= c[1] %></a><% }) %>
      <span>/</span><span aria-current="page"><%= title %></span>
    </nav>
    <h1 class="page-head__title"><%= title %></h1>
    <% if (locals.leadHtml) { %><p class="page-head__lead"><%- leadHtml %></p><% } else if (locals.lead) { %><p class="page-head__lead"><%= lead %></p><% } %>
  </div>
  <% if (art) { %><img class="page-head__art<%= art3d ? ' page-head__art--3d' : '' %>" src="/img/heads/<%= art %>" alt="" width="<%= art3d ? 1100 : 520 %>" height="<%= art3d ? 700 : 300 %>"><% } %>
</section>
