<!-- 1. Первый экран (вариант 4 «Журнал»): редакционный заголовок + мозаика материалов компании со смещёнными колонками -->
<% const hv = homeVideos[0]; const hc = homeCerts[0]; const pic = function(base, alt, extra){ return '<picture><source srcset="' + base + '.webp" type="image/webp"><img src="' + base + '.jpg" alt="' + alt + '" loading="' + (extra || 'lazy') + '"></picture>'; }; %>
<section class="mg-hero">
  <div class="container">
    <div class="mg-hero__head">
      <h1 class="mg-hero__title"><%= t('home.hero.title') %></h1>
      <div class="mg-hero__intro">
        <p><%= t('home.hero.subtitle') %></p>
        <button class="mg-round" type="button" data-lead="consult" aria-label="<%= s.btn_consult %>"><%- icon('arrow') %></button>
      </div>
    </div>
    <div class="mosaic4">
      <div class="mosaic4__col">
        <a class="mcard mcard--dark mcard--tall" href="<%= L('/video') %>">
          <span class="mcard__img"><%- pic('/img/art/art-flow', '', 'eager') %></span>
          <span class="mcard__body"><small><%= s.mag_collection %></small><strong><%= s.video_title %></strong></span>
        </a>
        <a class="mcard" href="<%= L('/o-kompanii') %>">
          <span class="mcard__img mcard__img--photo"><%- pic('/img/team/team-2-wide', s.hero_photo_alt) %></span>
          <span class="mcard__body"><small><%= s.team_title %></small><strong><%= s.mag_team %></strong></span>
        </a>
      </div>
      <div class="mosaic4__col mosaic4__col--shift">
        <a class="mcard mcard--mist" href="#faq">
          <span class="mcard__img"><%- pic('/img/art/art-dialog', '') %></span>
          <span class="mcard__body"><small><%= s.mag_questions %></small><strong><%= t('home.faq.title') %></strong></span>
        </a>
        <% if (hc) { %>
        <a class="mcard mcard--object" href="<%= L('/o-kompanii') %>#certs">
          <span class="mcard__img"><img src="<%= hc.image.replace(/\.jpg$/, '-sm.jpg') %>" alt="<%= f(hc, 'title') %>" loading="lazy"></span>
          <span class="mcard__body"><small><%= s.certs_title %></small><strong><%= f(hc, 'title') %></strong></span>
        </a>
        <% } %>
      </div>
      <div class="mosaic4__col">
        <% if (hv) { %>
        <a class="mcard mcard--portrait" href="<%= L('/video') %>">
          <span class="mcard__img"><img src="<%= hv.poster %>" alt="" loading="eager"></span>
          <span class="mcard__body"><small><%= s.mag_conversation %></small><strong><%= f(hv, 'title') %></strong><em class="mcard__btn"><%- icon('arrow') %><%= s.mag_watch %></em></span>
        </a>
        <% } %>
        <a class="mcard mcard--warm" href="#calculator">
          <span class="mcard__img"><%- pic('/img/art/art-growth', '') %></span>
          <span class="mcard__body"><small><%= s.calc_result %></small><strong><%= t('home.calc.title') %></strong></span>
        </a>
      </div>
    </div>
  </div>
</section>
