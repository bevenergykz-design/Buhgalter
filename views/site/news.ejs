<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('_page-head', { title: t('news.title'), lead: t('news.text') }) %>
<section class="section section--first">
  <div class="container">
    <div class="chips">
      <% cats.forEach(function(c){ %><a class="chip <%= cat === c ? 'is-active' : '' %>" href="<%= L('/novosti?cat=' + c) %>"><% if (c === 'video') { %><%- icon('image') %> <% } %><%= s.news_cats[c] %><% if (counts[c]) { %> <small><%= counts[c] %></small><% } %></a><% }) %>
    </div>
    <% if (cat === 'video') { %>
      <% if (!vids.length) { %><p class="empty"><%- icon('doc') %><%= s.news_empty %></p><% } else { %>
      <p class="section__lead news-video-lead"><%- include('_video-lead') %></p>
      <div class="vgrid vgrid--4"><% vids.forEach(function(v){ %><%- include('_video-card', { v: v }) %><% }) %></div>
      <% } %>
    <% } else if (!posts.length) { %>
      <p class="empty"><%- icon('doc') %><%= s.news_empty %></p>
    <% } else { %>
      <div class="posts">
        <% posts.forEach(function(p){ %><%- include('_post-card', { p: p }) %><% }) %>
      </div>
      <% if (pages > 1) { %>
      <nav class="pager">
        <% for (let i = 1; i <= pages; i++) { %><a class="<%= i === pageNo ? 'is-active' : '' %>" href="<%= L('/novosti?cat=' + cat + '&page=' + i) %>"><%= i %></a><% } %>
      </nav>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
