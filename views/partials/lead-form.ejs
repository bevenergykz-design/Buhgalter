<form class="lead-form" action="<%= L('/api/lead') %>" method="post" novalidate data-lead-form>
  <input type="hidden" name="type" value="<%= type %>">
  <input type="hidden" name="page" value="<%= curPath %>">
  <input type="hidden" name="service" value="<%= locals.service || '' %>">
  <input type="hidden" name="ts" value="">
  <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
  <div class="form-grid">
    <label class="field">
      <span class="field__label"><%= s.f_name %> *</span>
      <input class="input" type="text" name="name" required maxlength="120" autocomplete="name">
    </label>
    <label class="field">
      <span class="field__label"><%= s.f_phone %> *</span>
      <input class="input" type="tel" name="phone" required maxlength="40" autocomplete="tel" placeholder="+7 ___ ___ __ __" data-phone>
    </label>
    <% if (locals.withCompany) { %>
    <label class="field field--company">
      <span class="field__label"><%= s.f_company %></span>
      <input class="input" type="text" name="company" maxlength="200" autocomplete="organization">
    </label>
    <% } %>
    <% if (locals.withEmail) { %>
    <label class="field">
      <span class="field__label"><%= s.f_email %></span>
      <input class="input" type="email" name="email" maxlength="160" autocomplete="email">
    </label>
    <% } %>
    <% if (locals.withMessage) { %>
    <label class="field field--full field--message">
      <span class="field__label"><%= s.f_message %></span>
      <textarea class="input" name="message" rows="3" maxlength="3000"></textarea>
    </label>
    <% } %>
  </div>
  <label class="check">
    <input type="checkbox" name="consent" value="1" required>
    <span class="check__box"></span>
    <span class="check__text"><%- s.f_consent_html.replace('{privacy}', L('/politika-konfidencialnosti')) %></span>
  </label>
  <p class="form-error" role="alert" hidden></p>
  <button class="btn btn--accent btn--block btn--lg" type="submit"><%= s.f_send %></button>
</form>
