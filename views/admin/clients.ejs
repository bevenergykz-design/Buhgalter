<%- include('_top') %>
<div class="toolbar">
  <div class="seg-links">
    <a href="/admin/clients" class="<%= !status ? 'is-active' : '' %>">Все</a>
    <% E.CLIENT_STATUS.forEach(function(s){ %><a href="/admin/clients?status=<%= s[0] %>" class="<%= status === s[0] ? 'is-active' : '' %>"><%= s[1] %><% if (byStatus[s[0]]) { %> <small><%= byStatus[s[0]] %></small><% } %></a><% }) %>
  </div>
  <form class="search" method="get" action="/admin/clients">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <select class="input input--sm" name="acc" onchange="this.form.submit()">
      <option value="">Все бухгалтеры</option>
      <option value="me" <%= acc === 'me' ? 'selected' : '' %>>Мои клиенты</option>
      <% staffList.forEach(function(s){ %><option value="<%= s.id %>" <%= String(acc) === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }) %>
    </select>
    <%- icon('search') %><input class="input" type="search" name="q" value="<%= q %>" placeholder="Компания, БИН, контакт">
  </form>
  <a class="btn btn--primary btn--sm" href="/admin/clients/new"><%- icon('plus') %>Новый клиент</a>
</div>
<section class="panel panel--flush">
  <% if (!clients.length) { %><p class="empty-sm pad">Клиентов не найдено. Клиенты появляются здесь после регистрации в личном кабинете на сайте или после создания вручную.</p><% } else { %>
  <div class="table-wrap">
  <table class="table table--click">
    <thead><tr><th>Клиент</th><th>Форма / режим</th><th>Бухгалтер</th><th>Статус</th><th>Отчётность</th><th>Ближайший срок</th><th>Новое</th></tr></thead>
    <tbody>
    <% clients.forEach(function(c){ %>
      <tr data-href="/admin/clients/<%= c.id %>">
        <td><a href="/admin/clients/<%= c.id %>"><%= c.company %></a><br><small class="muted"><%= c.bin ? 'БИН ' + c.bin : 'БИН не указан' %> · <%= c.contact_name %></small></td>
        <td><%= opt(E.ENTITY_TYPES, c.entity_type) %><br><small class="muted"><%= opt(E.TAX_REGIMES, c.tax_regime) %></small></td>
        <td><%= c.acc_name || '—' %></td>
        <td><span class="st st--<%= c.status %>"><%= opt(E.CLIENT_STATUS, c.status) %></span></td>
        <td class="nowrap"><% if (c.overdue) { %><span class="st st--overdue"><%= c.overdue %> просроч.</span> <% } %><% if (c.open_reports) { %><span class="muted"><%= c.open_reports %> в работе</span><% } else if (!c.overdue) { %><span class="muted">—</span><% } %></td>
        <td class="nowrap"><%= c.next_deadline ? fmtDateShort(c.next_deadline) : '—' %></td>
        <td class="nowrap"><% if (c.unread) { %><span class="st st--in_progress"><%- icon('chat') %> <%= c.unread %></span> <% } %><% if (c.new_files) { %><span class="st st--waiting"><%- icon('doc') %> <%= c.new_files %></span><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>
<%- include('_bottom') %>
