<%- include('_top') %>
<div class="split">
  <nav class="side-list">
    <% groups.forEach(function(g){ %><a href="<%= ab %>/texts?grp=<%= encodeURIComponent(g) %>" class="<%= g === grp ? 'is-active' : '' %>"><%= g %></a><% }) %>
  </nav>
  <form class="panel form-stack" method="post" action="<%= ab %>/texts">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="grp" value="<%= grp %>">
    <div class="panel__head"><h2><%= grp %></h2><div class="lang-heads lang-heads--3"><span>Русский</span><span>Қазақша</span><span>English</span></div></div>
    <% items.forEach(function(it){ %>
    <div class="bi-field">
      <input type="hidden" name="key" value="<%= it.key %>">
      <div class="bi-field__label"><%= it.label %></div>
      <div class="bi-field__inputs bi-field__inputs--3">
        <% if (it.multiline) { %>
          <% ['ru', 'kk', 'en'].forEach(function(l){ const v = it[l] || ''; %><textarea class="input" name="<%= l %>__<%= it.key %>" lang="<%= l %>" rows="<%= Math.min(14, Math.max(3, Math.ceil(it.ru.length / 55) + it.ru.split('\n').length)) %>"><%= v %></textarea><% }) %>
        <% } else { %>
          <% ['ru', 'kk', 'en'].forEach(function(l){ %><input class="input" name="<%= l %>__<%= it.key %>" lang="<%= l %>" value="<%= it[l] || '' %>"><% }) %>
        <% } %>
      </div>
    </div>
    <% }) %>
    <div class="sticky-save"><button class="btn btn--primary" type="submit">Сохранить раздел</button><span class="muted">Изменения сразу появятся на сайте.</span></div>
  </form>
</div>
<%- include('_bottom') %>
