<%- include('_top') %>
<div class="grid-2 grid-2--wide">
  <form class="panel form-stack" method="post" action="/admin/tariffs">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>Цены калькулятора, ₸ в месяц</h2>
    <p class="muted">Итог = базовая стоимость (ИП или ТОО) + надбавка за ОУР + сотрудники × цена + надбавка за объём документов + выбранные опции.</p>
    <div class="form-grid">
      <% TARIFF_FIELDS.forEach(function(x){ %>
      <label class="field"><span class="field__label"><%= x[1] %></span><input class="input" type="number" min="0" step="500" name="<%= x[0] %>" value="<%= t[x[0]] || 0 %>" data-tariff></label>
      <% }) %>
    </div>
    <div><button class="btn btn--primary" type="submit">Сохранить цены</button></div>
  </form>
  <section class="panel">
    <h2>Проверка расчёта</h2>
    <p class="muted">Пример: ТОО на упрощёнке, 3 сотрудника, до 50 документов, без опций.</p>
    <p class="calc-preview"><span data-preview>—</span> ₸ / мес.</p>
    <p class="muted">Посетитель видит «от …» и примечание, что точную стоимость подтвердит менеджер. Текст примечания меняется в разделе «Тексты страниц → Главная: калькулятор».</p>
  </section>
</div>
<%- include('_bottom') %>
