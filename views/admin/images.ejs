<%- include('_top') %>
<form class="panel form-stack" method="post" action="<%= ab %>/images" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <p class="muted">Форматы JPG, PNG или WEBP. Для быстрой загрузки сайта используйте фото шириной 1200–1600 px.</p>
  <div class="img-grid">
    <% [['hero', 'Фото коллектива (главная, блок «О компании»)', 'Вертикальное фото команды, показывается рядом с названием компании'], ['og', 'Картинка для ссылок на сайт', 'Её показывают WhatsApp, Telegram, Instagram и соцсети, когда отправляют ссылку на сайт. Лучше горизонтальная, 1200 × 630 px. Мессенджеры обновляют её не сразу — до нескольких дней']].forEach(function(x){ %>
    <div class="img-field">
      <div class="img-field__label"><strong><%= x[1] %></strong><small><%= x[2] %></small></div>
      <% const prev = images[x[0]] || ({ hero: '/img/team/team-4.webp', og: '/img/og.jpg' })[x[0]]; %><div class="img-field__preview"><% if (prev) { %><img src="<%= prev %>" alt=""><% } else { %><span><%- icon('image') %>Не загружено</span><% } %></div><% if (!images[x[0]] && prev) { %><small class="muted">Сейчас стоит стандартная картинка</small><% } %>
      <input type="file" name="<%= x[0] %>" accept=".jpg,.jpeg,.png,.webp">
      <% if (images[x[0]]) { %><label class="check"><input type="checkbox" name="remove_<%= x[0] %>" value="1"><span class="check__box"></span><span class="check__text"><%= x[0] === 'hero' || x[0] === 'og' ? 'Вернуть стандартную картинку' : 'Убрать фото' %></span></label><% } %>
    </div>
    <% }) %>
  </div>
  <div><button class="btn btn--primary" type="submit">Сохранить</button></div>
</form>
<%- include('_bottom') %>
