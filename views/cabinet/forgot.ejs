<%- include('_auth-top') %>
<h1 class="auth__title"><%= s.c_forgot_title %></h1>
<% if (sent) { %>
  <p class="alert alert--ok"><%= s.c_forgot_sent %></p>
  <a class="btn btn--primary btn--block" href="<%= L('/cabinet/login') %>"><%= s.c_login_btn %></a>
<% } else { %>
  <p class="auth__lead"><%= s.c_forgot_text %></p>
  <form method="post" action="<%= L('/cabinet/forgot') %>" class="auth__form">
    <label class="field"><span class="field__label"><%= s.c_email %></span><input class="input" type="email" name="email" required autocomplete="email" autofocus></label>
    <button class="btn btn--primary btn--block btn--lg" type="submit"><%= s.c_forgot_btn %></button>
  </form>
  <div class="auth__switch"><a href="<%= L('/cabinet/login') %>"><%= s.c_login_btn %></a></div>
<% } %>
<%- include('_auth-bottom') %>
